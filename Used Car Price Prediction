import tkinter as tk
from tkinter import messagebox

# Create window
root = tk.Tk()
root.title("Car Price Predictor")
root.geometry("400x400")


# Labels and Input Boxes
tk.Label(root, text="Car Name").pack()
name_entry = tk.Entry(root)
name_entry.pack()

tk.Label(root, text="Company").pack()
company_entry = tk.Entry(root)
company_entry.pack()

tk.Label(root, text="Year").pack()
year_entry = tk.Entry(root)
year_entry.pack()

tk.Label(root, text="Kms Driven").pack()
kms_entry = tk.Entry(root)
kms_entry.pack()

tk.Label(root, text="Fuel Type").pack()
fuel_entry = tk.Entry(root)
fuel_entry.pack()


# Prediction Function
def predict_price():

    name = name_entry.get()
    company = company_entry.get()
    year = int(year_entry.get())
    kms = int(kms_entry.get())
    fuel = fuel_entry.get()

    prediction = pipe.predict(
        pd.DataFrame(
            {
                'name': [name],
                'company': [company],
                'year': [year],
                'kms_driven': [kms],
                'fuel_type': [fuel]
            }
        )
    )

    messagebox.showinfo(
        "Predicted Price",
        f"Estimated Price: ₹ {round(prediction[0], 2)}"
    )


# Predict Button
tk.Button(
    root,
    text="Predict Price",
    command=predict_price
).pack(pady=20)


# Run window
root.mainloop()
