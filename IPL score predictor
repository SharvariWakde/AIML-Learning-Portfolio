df['current_score'] = (
    df.groupby(['ID','innings'])['total_run']
      .cumsum()
)
df['current_wickets'] = (
    df.groupby(['ID','innings'])['isWicketDelivery']
      .cumsum()
)
df['balls_bowled'] = (
    df.groupby(['ID','innings'])
      .cumcount() + 1
)
df['current_overs'] = df['balls_bowled'] / 6
df['runs_last_30_balls'] = (
    df.groupby(['ID','innings'])['total_run']
      .rolling(30, min_periods=1)
      .sum()
      .reset_index(level=[0,1], drop=True)
)
df['wickets_last_30_balls'] = (
